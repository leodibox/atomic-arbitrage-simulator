# ---- shared with the worker ----------------------------------------------
HTTPS_URL=https://your-execution-node
WSS_URL=wss://your-execution-node
CHAIN_ID=1

# Deployed SandwichExecutor, and the key that owns it.
SANDWICH_EXECUTOR=0xYourSandwichExecutor
PRIVATE_KEY=0xOwnerKey

# Separate key that only signs Flashbots bundle headers (never spends).
IDENTITY_KEY=0xIdentityKey

# ---- relays --------------------------------------------------------------
# name|url|kind|auth ; kind = flashbots | titan | bloxroute
SANDWICH_RELAYS=flashbots|https://relay.flashbots.net|flashbots|

# ---- economics -----------------------------------------------------------
SANDWICH_MAX_FLOAT_WETH=3000000000000000000
SANDWICH_MIN_VICTIM_WETH=2000000000000000000
SANDWICH_MIN_SLIPPAGE_BPS=50
SANDWICH_MIN_REVENUE_WETH=100000000000000
SANDWICH_TIP_BPS=3000
SANDWICH_MAX_TIP_BPS=8000
SANDWICH_MAX_GAS_PRICE_GWEI=60
SANDWICH_GAS_UNITS=260000

# ---- risk ----------------------------------------------------------------
SANDWICH_MAX_BLOCKS=2
SANDWICH_MAX_RESERVE_AGE_BLOCKS=1
SANDWICH_MAX_INFLIGHT=1
SANDWICH_UNWIND_AFTER_BLOCKS=3

# ---- pool universe (reuses scanner discovery) ----------------------------
SANDWICH_MIN_POOL_WETH=25000000000000000000
SANDWICH_REFRESH_BLOCKS=25
SANDWICH_EXTRA_POOLS=

# ---- feed ----------------------------------------------------------------
# txpool = poll txpool_content (needs an Erigon/Geth node with txpool on)
# full   = newPendingTransactions with full bodies
SANDWICH_FEED=txpool
SANDWICH_POLL_MS=400

# ---- mode ----------------------------------------------------------------
SANDWICH_DRY_RUN=true
RUST_LOG=info